update-dotfiles()
{
    local current_directory="$PWD"
    local dotfiles_directory="${DOTFILES:-$HOME/.dotfiles}"

    cd "$dotfiles_directory" || return 1

    if ! git pull --ff-only; then
        cd "$current_directory"
        echo "Failed to pull the latest dotfiles changes" >&2
        return 1
    fi

    if command -v just > /dev/null; then
        just update
    else
        zsh setup.zsh
    fi
    local update_status=$?

    cd "$current_directory" || return 1
    if (( update_status != 0 )); then
        echo "Failed to update dotfiles" >&2
    fi
    return "$update_status"
}
